# Resolve extensionless app URLs through their static directory indexes.
# Disable MultiViews so Apache does not prefer a colliding *.html alias.
Options -MultiViews
DirectoryIndex index.html
DirectorySlash On

# Keep Piktali assets path-versioned on Loopia while storing only one copy.
# Query strings can be ignored by some host caches, so rewrite the versioned
# public URL to the stable on-disk asset after the cache has seen its new path.
RewriteEngine On
RewriteRule ^piktali-pictograms/v[A-Za-z0-9._-]+/assets/(.+)$ piktali-pictograms/assets/$1 [END]

# Never cache the live entry point, fallback, or service-worker script.
<IfModule mod_headers.c>
  <FilesMatch "^(service-worker\.js|index\.html|fallback\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Accel-Expires "0"
  </FilesMatch>
</IfModule>
