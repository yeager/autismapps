# Resolve extensionless app URLs through their static directory indexes.
# Disable MultiViews so Apache does not prefer a colliding *.html alias.
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off

# Keep Piktali pictograms and official traffic signs path-versioned on Loopia,
# while storing only one copy of each asset.
# Query strings can be ignored by some host caches, so rewrite the versioned
# public URL to the stable on-disk asset after the cache has seen its new path.
RewriteEngine On
# This directory has its own rewrite rules, so the public_html rule does not
# reliably reach launcher routes. Keep Swedish legacy URLs on the localized
# build's base path before directory and asset handling.
RewriteCond %{REQUEST_URI} ^/launcher/launcher(?:/|$) [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autismappar\.se$ [NC]
RewriteRule ^launcher/?(.*)$ https://autismappar.se/launcher-sv/$1 [R=301,L,NE]
RewriteCond %{REQUEST_URI} ^/launcher/launcher(?:/|$) [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autismapps\.online$ [NC]
RewriteRule ^launcher/?(.*)$ https://autismapps.online/launcher/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?autismappar\.se$ [NC]
RewriteCond %{REQUEST_URI} ^/launcher(?:/|$) [NC]
RewriteRule ^(.*)$ https://autismappar.se/launcher-sv/$1 [R=302,L,NE]

# Loopia terminates TLS before Apache. mod_dir can therefore build its
# DirectorySlash redirect with an http:// Location even for HTTPS requests.
# Canonicalize real launcher directories explicitly over HTTPS instead.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI}/ [R=301,L,NE]
RewriteRule ^piktali-pictograms/v[A-Za-z0-9._-]+/assets/(.+)$ piktali-pictograms/assets/$1 [END]
RewriteRule ^pictograms/traffic-safety/v[A-Za-z0-9._-]+/signs/(.+)$ pictograms/traffic-safety/signs/$1 [END]

# Never cache the live entry point, fallback, or service-worker script.
<IfModule mod_headers.c>
  <FilesMatch "^(service-worker\.js|index\.html|fallback\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
    Header set X-Accel-Expires "0"
  </FilesMatch>
</IfModule>
