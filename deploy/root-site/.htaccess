# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

# Revalidate HTML documents, robots.txt, and service-worker scripts so hosts and
# browsers do not keep serving stale site content. Fingerprinted assets stay cached.
<IfModule mod_headers.c>
    <FilesMatch "^(service-worker\.js|.*\.html?|lang\.js|robots\.txt)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-Accel-Expires "0"
    </FilesMatch>
</IfModule>

# COOP/COEP headers for SharedArrayBuffer (Piper WASM TTS)
<IfModule mod_headers.c>
    Header set Cross-Origin-Opener-Policy "same-origin"
    Header set Cross-Origin-Embedder-Policy "credentialless"
    Header set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# Canonical routes and host-specific static landing pages.
RewriteEngine On

# Block version-control metadata at every path depth.
RewriteRule (^|/)\.(?:git|svn|hg)(?:/|$) - [F,L,NC]
RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
RewriteRule ^index\.php$ / [R=301,L]

RewriteCond %{THE_REQUEST} /index-en\.html [NC]
RewriteRule ^index-en\.html$ https://autismapps.online/ [R=301,L]

RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?autismapps\.online$ [NC]
RewriteRule ^index\.html$ https://autismapps.online/ [R=301,L]
RewriteCond %{THE_REQUEST} /index\.html [NC]
RewriteRule ^index\.html$ https://autismappar.se/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?autismapps\.online$ [NC]
RewriteRule ^$ index-en.html [L]
RewriteRule ^$ index.html [L]

# Redirect Swedish legacy launcher URLs to the Swedish build's own base path.
# An internal rewrite served HTML built for /launcher-sv at a /launcher URL,
# which made SvelteKit fail during hydration on the old public links.
RewriteCond %{HTTP_HOST} ^(www\.)?autismappar\.se$ [NC]
RewriteRule ^launcher/launcher/?(.*)$ https://autismappar.se/launcher-sv/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(www\.)?autismapps\.online$ [NC]
RewriteRule ^launcher/launcher/?(.*)$ https://autismapps.online/launcher/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(www\.)?autismappar\.se$ [NC]
RewriteRule ^launcher/?(.*)$ https://autismappar.se/launcher-sv/$1 [R=302,L,NE]
