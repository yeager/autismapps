{
  "name": "autismapps",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:launcher": "node scripts/build-launcher.mjs",
    "build:launcher:domains": "node scripts/build-launcher-domains.mjs",
    "verify:launcher:locales": "node scripts/verify-launcher-locales.mjs",
    "audit:links": "node scripts/audit-internal-links.mjs",
    "audit:pictograms": "node scripts/audit-pictograms.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:arasaac": "node --test scripts/tests/arasaac-search-normalize.test.mjs",
    "test": "node --experimental-strip-types --test \"scripts/tests/*.test.mjs\"",
    "check:i18n": "node scripts/check-i18n.mjs",
    "postinstall": "npx patch-package",
    "tauri": "tauri",
    "generate:piktali-dictionary-index": "node scripts/generate-piktali-dictionary-index.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.53.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "svelte": "^5.51.0",
    "svelte-check": "^4.3.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "^1.0.4",
    "dexie": "^4.3.0"
  }
}
